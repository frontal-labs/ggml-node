{
  "name": "inboard",
  "version": "0.1.0",
  "description": "An LLM inside your Node process. No daemon, no API key, no port.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "bin": {
    "inboard": "./dist/cli/index.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run test/unit",
    "test:e2e": "INBOARD_E2E=1 vitest run test/e2e",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "registry:generate": "tsx scripts/compute-checksums.ts"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.34",
    "node-llama-cpp": "^3.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "ai": "^7.0.157",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@9.0.0"
}
