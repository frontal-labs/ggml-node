{
  "name": "inboard-sdk",
  "version": "0.1.0",
  "description": "An LLM inside your Node process. No daemon, no API key, no port.",
  "license": "MIT",
  "author": "Frontal Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontal-labs/inboard.git"
  },
  "homepage": "https://github.com/frontal-labs/inboard#readme",
  "bugs": {
    "url": "https://github.com/frontal-labs/inboard/issues"
  },
  "keywords": [
    "llm",
    "local",
    "node-llama-cpp",
    "gguf",
    "ai-sdk",
    "structured-output",
    "offline"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "examples/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "bin": {
    "inboard": "./dist/cli/index.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run tests/unit",
    "test:e2e": "INBOARD_E2E=1 vitest run tests/e2e",
    "registry:generate": "tsx scripts/compute-checksums.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run verify && changeset publish",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.34",
    "@t3-oss/env-core": "^0.13.11",
    "commander": "^15.0.0",
    "node-llama-cpp": "^3.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "ai": "^7.0.157",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
