{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run test:e2e)",
      "Bash(bun run build)",
      "Bash(bun run verify)",
      "Bash(bun run registry:generate)",
      "Bash(bun run format)",
      "Bash(bun run prepare)",
      "Bash(bun run changeset)",
      "Bash(bun run commit)",
      "Bash(bun run version-packages)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bunx biome check:*)",
      "Bash(bunx tsc --noEmit)",
      "Bash(bunx vitest run:*)",
      "Bash(node dist/cli/index.js:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(bun run release)",
      "Bash(bun run release:publish)",
      "Bash(changeset publish:*)",
      "Bash(npm publish:*)",
      "Bash(bun publish:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/Library/Caches/node-slm/**)"
    ]
  },
  "env": {
    "NODE_SLM_E2E": "0"
  },
  "includeCoAuthoredBy": true
}
